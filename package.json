{
  "name": "maree-morte",
  "version": "1.6.0",
  "description": "Marée Morte — MMORPG 2D en ligne, pirates contre zombies",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build:artifact": "node scripts/build-artifact.mjs",
    "build:pages": "node scripts/build-artifact.mjs --pages",
    "build": "node scripts/build-artifact.mjs && node scripts/build-artifact.mjs --pages",
    "test": "node tests/run.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "peer": "^1.0.2",
    "peerjs": "^1.5.5"
  }
}
